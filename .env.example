# Copy to api/.env (never commit the real file). Every setting has a safe local default.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fieldcard
CORS_ORIGINS=http://localhost:5173

# --- Production only -------------------------------------------------------
# ENV=prod
# SECRET_KEY=<64 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))">
# COOKIE_SECURE=true
# COOKIE_PATH=/api/auth          # only when a proxy serves the API under /api (see vercel.json)
# TRUST_PROXY_HOPS=1             # Render sits behind one proxy
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# S3_BUCKET=job-photos           # a PRIVATE bucket
# S3_REGION=<project region>
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# SIGNUP_ENABLED=false           # public portfolio site: visitors use the demo instead
# DEMO_ENABLED=true
